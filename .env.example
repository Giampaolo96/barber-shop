# Copia questo file in .env.local (ignorato da git) e compila i valori.
# In locale i valori Supabase si leggono dall'output di `npx supabase status`.

# URL dell'API Supabase (in locale: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Chiave pubblica (anon): può stare nel client, è protetta dalle policy RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave privilegiata: SOLO lato server ed Edge Functions, mai con prefisso NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Email transazionali (Resend), solo lato server
RESEND_API_KEY=
