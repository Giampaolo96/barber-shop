{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "PONYTAIL_SUBAGENT_MATCHER": "^(?!spec-qa$)"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx supabase *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(npx supabase db push *)",
      "Bash(npx.cmd supabase db push *)",
      "Bash(supabase db push *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/quality-gate.ps1",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git",
        "ref": "v5.3.3"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
